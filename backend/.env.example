# Supabase Connection
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT for OUR backend (not Supabase)
SECRET_KEY=your-secret-key-here-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=525600

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Environment
ENVIRONMENT=development

# TTS 공급자 선택 — edge_tts(기본값, 무료) 또는 google(정식 운영 전환용).
# google로 바꾸려면 아래 GOOGLE_APPLICATION_CREDENTIALS_JSON도 채워야 한다.
TTS_PROVIDER=edge_tts

# Google Cloud TTS 서비스 계정 키(JSON) 원문. GCP 콘솔에서 프로젝트 생성 ->
# Text-to-Speech API 활성화 -> 서비스 계정 키 발급 후, 그 JSON 파일
# 내용을 한 줄로 그대로 붙여넣는다(파일 마운트가 어려운 배포 환경 대응).
# GOOGLE_APPLICATION_CREDENTIALS(파일 경로)를 쓸 수 있으면 이 변수는
# 비워둬도 된다.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
