# Supabase Connection
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT for OUR backend (not Supabase)
SECRET_KEY=your-secret-key-here-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=525600

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Environment
ENVIRONMENT=development

# 어떤 음성이 어느 TTS 엔진을 쓰는지는 backend/tts_providers/voice_catalog.py에
# 음성별로 고정돼 있다(전역 스위치 아님). Google 음성을 쓰려면(카론/코어,
# 기본 제공 오디오북) 아래 GOOGLE_APPLICATION_CREDENTIALS_JSON을 채워야 한다.

# Google Cloud TTS 서비스 계정 키(JSON) 원문. GCP 콘솔에서 프로젝트 생성 ->
# Text-to-Speech API 활성화 -> 서비스 계정 키 발급 후, 그 JSON 파일
# 내용을 한 줄로 그대로 붙여넣는다(파일 마운트가 어려운 배포 환경 대응).
# GOOGLE_APPLICATION_CREDENTIALS(파일 경로)를 쓸 수 있으면 이 변수는
# 비워둬도 된다.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
